# Python executable PM2 should run. Point this at the same venv where tag101 is
# installed.
PYTHON_BIN=/home/user/tag101/.venv/bin/python

# Host paths used directly by the local Python process.
WALLET_HOST_PATH=/home/user/.bittensor/wallets
STATE_HOST_DIR=/home/user/node-state/miner

# The deploy script passes --axon.port and --axon.external_port from this value
# unless later NODE_ARGS or CLI args override them.
AXON_PORT=<MINER_AXON_PORT>
# Real public IP/port validators reach via the Tag101 task-server private registry.
AXON_EXTERNAL_IP=<MINER_AXON_EXTERNAL_IP>

# Hide 144.x.x.x from the public Finney metagraph (validators still find you privately).
# Requires the default task-server flow; do not combine with MINER_AXON_TO_PUBLIC_METAGRAPH.
# MINER_HIDE_AXON_FROM_METAGRAPH=true

# The default SN101 reference miner uses OpenAI for tag generation.
# OPENAI_API_KEY=<OPENAI_API_KEY>
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Optional PM2 process flags. When unset, pm2_node applies resilient defaults:
# restart delay, unlimited restarts, exponential backoff, graceful kill timeout.
# PM2_START_ARGS=--max-memory-restart 8G

# Base miner args. Fill in endpoint and wallet values before starting. Extra CLI
# args after "--" in pm2_node.py are appended after this value and therefore win
# if an option appears twice.
# Quote NODE_ARGS — required if any tool sources this file with bash.
NODE_ARGS="--netuid 101 --subtensor.network <SUBTENSOR_ENDPOINT> --wallet.name <WALLET_NAME> --wallet.hotkey <HOTKEY_NAME> --logging.info"
# To override a task solver in the miner environment, append:
#   --task.miner_module your_package.your_miner_module
