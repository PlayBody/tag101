# Docker image tag built by python -m tag101.deploy.docker_node build.
NODE_IMAGE=tag101:latest

# Host paths mounted into the container.
WALLET_HOST_PATH=/home/user/.bittensor/wallets
STATE_HOST_DIR=/home/user/node-state/miner

# Containers use host networking by default, so no Docker -p forwarding is
# needed. The deploy script still passes --axon.port and --axon.external_port
# from this value unless later args override them.
DOCKER_NETWORK=host
# AXON_PORT=<MINER_AXON_PORT>
# AXON_EXTERNAL_IP=<MINER_AXON_EXTERNAL_IP>

# GPU miners need NVIDIA driver and NVIDIA Container Toolkit on the host.
# Uncomment to pass the Docker GPU runtime flag, equivalent to docker run --gpus all.
# DOCKER_GPUS=all

# The default SN101 reference miner uses OpenAI for tag generation.
# OPENAI_API_KEY=<OPENAI_API_KEY>
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# Base miner args. Fill in endpoint and wallet values before starting. Extra CLI
# args after "--" in docker_node.py are appended after this value and therefore
# win if an option appears twice.
# NODE_ARGS=--netuid 101 --subtensor.network <SUBTENSOR_ENDPOINT> --wallet.name <WALLET_NAME> --wallet.hotkey <HOTKEY_NAME> --logging.info
# Recommended competitive miner (scoring-aware, uses same validator rules locally):
#   --task.miner_module tag101.tasks.competitive_sn101
# Optional stronger model:
#   OPENAI_MODEL=gpt-4o
# Observability (enabled by default; logs under neuron.storage_dir or MINER_LOG_DIR):
#   validator_tasks/events.jsonl  — replay with tag101-benchmark --replay-log ... --improve
#   api_cost/events.jsonl         — daily spend with tag101-benchmark --cost-log ...
#   tag101-register-check --min-probability 0.70   # run BEFORE registering
#   tag101-benchmark --crowd-size 30 --show-clusters
#   tag101-benchmark --post "your post text" --include-reference --show-clusters
